# Все переменные опциональны. Пустое значение включает честную заглушку:
# слот видео показывает «материал пока не подключён», внешняя кнопка становится
# неактивной с подписью. Воронка проходима до конца при полностью пустом файле,
# и это проверяет `src/router/walkthrough.test.tsx`.
#
# В продакшене значения задаются не здесь, а в настройках репозитория:
# Settings → Secrets and variables → Actions → Variables. После изменения
# переменной нужно перезапустить workflow Deploy — значения подставляются
# на сборке.

# Голосовое вступление автора: им начинается воронка. Человек нажимает
# воспроизведение — и город меняется под голос. Пусто = пузырь честно говорит,
# что записи нет, а вступление идёт текстом по таймеру, как раньше.
# Формат: mp3 или m4a, лежит рядом со сборкой либо на любом адресе с CORS.
VITE_VOICE_INTRO_URL=

# Три главы обучения (docs/SPEC.md §3.3). Пока не сняты.
VITE_VIDEO_1_URL=
VITE_VIDEO_2_URL=
VITE_VIDEO_3_URL=

# Ассистенты, которых автор показывает внутри глав. Ссылка ведёт в чат с
# готовым ассистентом наружу. Первый разбирает аудиторию, второй собирает
# предложение на его результатах.
VITE_ASSISTANT_AUDIENCE_URL=
VITE_ASSISTANT_OFFER_URL=

# Куда мини-апп шлёт события прохождения: показ шага, такт сцены, глава, исход
# проверки, собранный участок связки, переходы по внешним кнопкам. Обычно это
# ручка бота, из которого человек пришёл, — у него уже есть его Telegram id,
# значит он сможет и посчитать отвал, и дожать тех, кто не купил.
# Пусто = аналитика выключена, воронка проходится как обычно.
VITE_ANALYTICS_URL=

# Сайт, собранный в третьей главе. По нему человек тыкает сам — это главное
# доказательство всей воронки: он видел, как страницу делают, и теперь трогает
# результат. Появится вместе с записью третьей главы.
VITE_LANDING_DEMO_URL=

# Оплата TRAFFIC LAB за 3 990 ₽.
VITE_CHECKOUT_URL=

# Поддержка.
VITE_SUPPORT_URL=
